{
  "name": "chargebacks-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\" && prisma migrate deploy && npm run seed && npm run sample",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sample": "tsx scripts/sample.ts",
    "representment": "tsx --env-file-if-exists=.env scripts/representment.ts",
    "ruling": "tsx --env-file-if-exists=.env scripts/ruling.ts",
    "reset": "prisma migrate reset --force --skip-seed && node -e \"require('fs').rmSync('uploads',{recursive:true,force:true})\" && npm run seed && npm run sample",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
